  stageNumber: 1
  words:
  - wordId: stage1_mitigate
    word: MITIGATE
    partOfSpeech: verb
    definition: To reduce the severity or harmful effect of something.
    contextSentence: The shield helped mitigate the damage.
    combatClue: Form the word that means to reduce the severity of harm.
    reviewQuestion: Which word means to reduce the severity of a problem?
    distractors:
    - word: INTENSIFY
      explanation: Intensify means to make something stronger or more severe.
    - word: EXPAND
      explanation: Expand means to increase in size, amount, or scope.
    - word: IGNORE
      explanation: Ignore means to deliberately pay no attention to something.
