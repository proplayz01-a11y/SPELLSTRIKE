  stageNumber: 3
  words:
  - wordId: stage3_scorched
    word: SCORCHED
    encounterId: stage3_sunbound_warden
    opportunityTiming: 1
    successEffectId: scorched_warden_gate
    partOfSpeech: adjective
    phoneticSpelling: "/sk\u0254\u02D0rt\u0283t/"
    definition: Burned, dried, or damaged by intense heat.
    contextSentence: The scorched ground cracked beneath the desert sun.
    combatClue: Form the word that means burned or dried by intense heat.
    challengeDistractorLetters: BLUNTIFY
    reviewQuestion: Which sentence correctly uses the word SCORCHED?
    distractors: []
    reviewChoices:
    - sentence: The scorched ground was dry and blackened by the intense heat.
      correct: 1
      explanation: SCORCHED is used correctly in this sentence.
    - sentence: The map was scorched because the traveler folded it carefully.
      correct: 0
      explanation: This does not match the meaning of SCORCHED.
    - sentence: The guard called the cool spring water scorched.
      correct: 0
      explanation: This does not match the meaning of SCORCHED.
    - sentence: The merchant scorched the coins by counting them twice.
      correct: 0
      explanation: This does not match the meaning of SCORCHED.
